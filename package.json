{
  "name": "@onlemary/events-core",
  "version": "0.1.1",
  "description": "Critical system events buffer + notification policy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy/index.js",
      "default": "./dist/policy/index.js"
    },
    "./storage": {
      "types": "./dist/storage/queries.d.ts",
      "import": "./dist/storage/queries.js",
      "default": "./dist/storage/queries.js"
    },
    "./schemas": {
      "types": "./dist/buffered-event/schemas.d.ts",
      "import": "./dist/buffered-event/schemas.js",
      "default": "./dist/buffered-event/schemas.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./dispatch-fn": {
      "types": "./dist/dispatch-fn.d.ts",
      "import": "./dist/dispatch-fn.js",
      "default": "./dist/dispatch-fn.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "events-core-db-setup": "./dist/db-setup.js"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "scripts",
    "README.md",
    "COMO-USAR.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.events-core.example"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlemary/events-core.git"
  },
  "scripts": {
    "build": "rm -rf dist && prisma generate && tsc -p tsconfig.json && chmod +x dist/db-setup.js",
    "dev": "tsc --watch",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:watch": "vitest",
    "test:integration": "EVENTS_CORE_TEST_DB_URL=postgres://test:test@localhost:5432/events_core_test_db vitest run tests/integration",
    "db:setup": "node dist/db-setup.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "events",
    "system-events",
    "notifications",
    "policy",
    "buffer",
    "multi-tenant"
  ],
  "author": "onlemary",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.13.0",
    "prisma": "^7.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "fast-check": "^4.6.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
